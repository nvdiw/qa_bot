BOT_TOKEN='BOT_TOKEN'
# تنظیمات ربات تلگرام
# توکن ربات از BotFather

ADMIN_ID='ADMIN_ID'
# لیست ادمین‌ها (بدون owner) - با کاما جدا شود
# مثال: ADMIN_IDS=11111111,22222222

# لیست owner ها - با کاما جدا شود
# مثال: OWNER_IDS=33333333,44444444
OWNER_IDS='OWNER_IDS'

# کلید دستور امن برای دریافت chat_id/user_id
# مثال استفاده در تلگرام: /secureid AzSxDcFvGb1548962
ADMIN_DISCOVERY_KEY=AzSxDcFvGb1548962

# راهنمای دستورات (برای کارفرما)
# /start  شروع
# /help   راهنما
# /admin  منوی ادمین
# /owner  منوی owner
# /stats  آمار
# /list   لیست سوال‌وجواب
# /pending سوالات بی‌پاسخ
# /reload بارگذاری مجدد داده
